          }
        },
        "slide_hFbVVd": {
          "type": "Slide",
          "settings": {
            "heading": "Narbe nach nur zwei Behandlungen blasser",
            "product": "Micro-Infusion-System",
            "stars_img": "shopify://shop_images/results_star-full.svg",
            "text": "<p>„Ich habe das Gefühl, dass meine Haut Produkte besser aufnimmt und mehr strahlt. Außerdem hat eine größere Aknenarbe auf meiner rechten Wange nach nur zwei Behandlungen begonnen, blasser zu werden !“</p>",
            "image": "shopify://shop_images/results_mona.webp",
