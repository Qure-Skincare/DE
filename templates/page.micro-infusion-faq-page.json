    "two_column_box_Ck6gNH": {
      "type": "two-column-box",
      "blocks": {
        "content_bWjYX9": {
          "type": "content",
          "settings": {
            "text": "<h2>Wirkt das Qure Micro-Infusionssystem bei Falten?</h2>",
            "column_content": 0,
