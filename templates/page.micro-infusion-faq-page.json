        "steps_7MCadz": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/mi_faq_use_1.webp",
            "text_content": "<p><strong>Hautvorbereitung: </strong>Reinigen Sie Ihr Gesicht gründlich, um Make-up und Unreinheiten zu entfernen. Tupfen Sie die Haut mit einem sauberen Handtuch trocken.</p>"
          }
        },
        "steps_hJH6Hw": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/mi_faq_use_2.webp",
            "text_content": "<p><strong>Gerät vorbereiten: </strong>Drehen Sie die Kammer auf und füllen Sie sie mit einer Ampulle des von Ihnen gewählten Serums. Befestigen Sie den Mikronadelkopf, indem Sie ihn fest aufdrehen.</p>"
          }
        },
        "steps_8at44M": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/mi_faq_use_3.webp",
            "text_content": "<p><strong>Gerät aktivieren: </strong>Lassen Sie das Gerät 1–2 Minuten lang auf dem Kopf stehen, damit das Serum in die Mikronadeln fließen kann.</p>"
          }
        },
        "steps_hWbjmD": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/mi_faq_use_4.webp",
            "text_content": "<p><strong>Micro-Infusion starten: </strong>Entfernen Sie den Deckel und drücken Sie das Gerät sanft auf Ihre Haut, beginnend in der Gesichtsmitte und nach außen hin arbeitend. Verwenden Sie eine stempelnde Bewegung, um eine gleichmäßige Verteilung zu gewährleisten.</p>"
          }
        },
        "steps_ynbAn8": {
          "type": "steps",
          "settings": {
            "step_image": "shopify://shop_images/mi_faq_use_5.webp",
            "text_content": "<p><strong>Nachbehandlung: </strong>Klopfen Sie das restliche Serum sanft auf Gesicht und Hals ein. Setzen Sie anschließend den Deckel wieder auf den Nadelkopf, drehen Sie ihn fest zu und entsorgen Sie ihn sicher.</p>"
          }
        }
      },
