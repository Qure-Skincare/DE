<link rel="stylesheet" href="{{ 'cookies.css' | asset_url }}">

<div class="modal fade p-0" id="gdpr" aria-labelledby="gdpr" aria-hidden="true">
    <div class="modal-dialog modal-dialog-end">
        <div class="modal-content rounded-0 border-0">
            <div class="container">
                <div class="cookies_wrap">
                    <div class="row">
                        <div class="col-md-7">
                            <h5>Wir schätzen Ihre Privatsphäre </h5>
                            <p>Wir verwenden Cookies, um Ihr Surferlebnis zu verbessern, personalisierte Werbung oder Inhalte bereitzustellen und unseren Datenverkehr zu analysieren.  </p>
                        </div>
                        <div class="col-md-5">
                            <div class="cookie_btn_wrap">
                                <button class="btn btn_black" id="gdpr_accept">Alle akzeptieren</button>
                                <button class="btn btn_white" id="gdpr_settings_change">Einstellungen ändern</button>
                                <button class="btn btn_white" id="gdpr_reject">Alle ablehnen</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade p-0" id="gdpr_settings" aria-labelledby="gdpr_settings" aria-hidden="true">
    <div class="modal-dialog modal-dialog-end">
        <div class="modal-content rounded-0 border-0">
            <div class="container">
                <div class="cookies_wrap">
                    <div class="row">
                        <div class="col-md-7">
                            <h5>Anpassen Ihrer Cookie-Einstellungen</h5>
                            <p>Wir respektieren Ihre Privatsphäre und bieten Ihnen die Möglichkeit, Ihre Cookie-Einstellungen anzupassen. Bitte wählen Sie aus, welche Arten von Cookies Sie akzeptieren möchten: <a
                                    href="https://www.qureskincare.de/pages/privacy-page"
                                    class="cookies_link">Weitere Informationen</a></p>
                            <div class="cookie_btn_wrap m-0 mt-4">
                                <button class="btn btn_black" id="gdpr_accept_settings">Präferenzen speichern</button>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="cookies_dropdown faq">
                                <div class="accordion" id="accordionExample">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingOne">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6>Streng notwendige Cookies</h6>
                                                <label class="switch">
                                                    <input type="checkbox" id="b1" name="b2" value="" checked=""
                                                        disabled>
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                            <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapseOne"
                                                aria-expanded="true" aria-controls="collapseOne">
                                                <div class="container">
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapseOne" class="accordion-collapse collapse"
                                            aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                                            <div class="accordion-body">
                                                <p>Diese Cookies sind für das ordnungsgemäße Funktionieren der Website unerlässlich. Sie ermöglichen grundlegende Funktionen wie die Seitennavigation und den Zugang zu sicheren Bereichen der Website. Die Website kann ohne diese Cookies nicht richtig funktionieren.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingTwo">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6>Leistung Cookies</h6>
                                                <label class="switch">
                                                    <input type="checkbox" id="b2" name="b2" value="">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                            <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapseTwo"
                                                aria-expanded="false" aria-controls="collapseTwo">
                                                <div class="container">
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapseTwo" class="accordion-collapse collapse"
                                            aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                            <div class="accordion-body">
                                                <p>Diese Cookies helfen uns zu verstehen, wie Besucher mit unserer Website interagieren, indem sie Informationen anonym sammeln und melden. Sie ermöglichen es uns, die Leistung der Website und die Benutzerfreundlichkeit zu verbessern.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingThree">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6>Funktionale Cookies</h6>
                                                <label class="switch">
                                                    <input type="checkbox" id="b3" name="b3" value="">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                            <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapseThree"
                                                aria-expanded="false" aria-controls="collapseThree">
                                                <div class="container">
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapseThree" class="accordion-collapse collapse"
                                            aria-labelledby="headingThree" data-bs-parent="#accordionExample">
                                            <div class="accordion-body">
                                                <p>Diese Cookies ermöglichen es der Website, sich an die von Ihnen getroffenen Entscheidungen zu erinnern (z. B. an Ihren Benutzernamen, Ihre Sprache oder die Region, in der Sie sich befinden) und verbesserte, persönlichere Funktionen anzubieten.</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="headingFour">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h6>Targeting/Werbung Cookies</h6>
                                                <label class="switch">
                                                    <input type="checkbox" id="b4" name="b4" value="">
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                            <button class="accordion-button collapsed" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#collapseFour"
                                                aria-expanded="false" aria-controls="collapseFour">
                                                <div class="container">
                                                </div>
                                            </button>
                                        </h2>
                                        <div id="collapseFour" class="accordion-collapse collapse"
                                            aria-labelledby="headingFour" data-bs-parent="#accordionExample">
                                            <div class="accordion-body">
                                                <p>Diese Cookies werden verwendet, um Werbung zu liefern, die für Sie und Ihre Interessen relevanter ist. Sie können auch verwendet werden, um die Anzahl der Werbeeinblendungen zu begrenzen und die Wirksamkeit der Werbekampagne zu messen. Sie werden in der Regel von Werbenetzwerken mit der Erlaubnis des Website-Betreibers gesetzt.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var gdrpModal = new bootstrap.Modal(document.getElementById('gdpr'), {});
    var gdrpSettingsModal = new bootstrap.Modal(document.getElementById('gdpr_settings'), {});

    function gdpr_setCookie(name, value, days) {
        var date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        var expires = "expires=" + date.toUTCString();
        document.cookie = name + "=" + value + ";" + expires + ";path=/";
    }

    // Function to get a cookie by name
    function gdpr_getCookie(name) {
        var nameEQ = name + "=";
        var ca = document.cookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') c = c.substring(1);
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
    }

    document.addEventListener('DOMContentLoaded', function() {


    
        document.querySelector('#gdpr_settings_change').addEventListener('click', function() {
            event.preventDefault();
            gdrpSettingsModal.show();
        });

        if (!getCookie("gdrp")) {
            setTimeout(() => {
                gdrpModal.show();
            }, 750);
        }

        document.querySelector('#gdpr_reject').addEventListener('click', function() {
            event.preventDefault();
            gdpr_setCookie("gdrp", "true", 365);
            gdrpModal.hide();
        });

        document.querySelector('#gdpr_accept').addEventListener('click', function() {
            event.preventDefault();
            gdpr_setCookie("gdrp", "true", 365);
            gdrpModal.hide();
        });

        document.querySelector('#gdpr_accept_settings').addEventListener('click', function() {
            event.preventDefault();
            gdpr_setCookie("gdrp", "true", 365);
            gdrpModal.hide();
            gdrpSettingsModal.hide();
        });
    });
</script>