                                                <p><span><img src="{{ 'tick.png' | asset_url }}" alt=""></span>Weltweiter Versand (im Wert von 25 €)</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab_content" id="month_1">
